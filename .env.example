# Herbarium Finance - Environment Variables Template
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to Git - it contains sensitive information

# Supabase Configuration
# Get these values from your Supabase project dashboard
# Go to: Settings → API → Project URL and Project API keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service-role key — required ONLY for cron scripts (e.g. gmail classifier).
# Bypasses RLS; never use in client-side code. Get from Supabase dashboard:
# Settings → API → service_role secret.
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter — for the gmail classifier (issue #13). Sign up at openrouter.ai.
OPENROUTER_API_KEY=
# Optional override — defaults to google/gemini-2.0-flash-lite-001
OPENROUTER_MODEL=

# Instructions:
# 1. Copy this file: cp .env.example .env.local
# 2. Replace the placeholder values with your actual Supabase credentials
# 3. Save the file
# 4. Start your development server: pnpm dev

# Security Notes:
# - The .env.local file is automatically ignored by Git
# - Never share your actual keys publicly
# - Use different Supabase projects for development and production
# - Regenerate keys if they are ever compromised
